# Server-only Supabase configuration. Never commit a secret/service-role key.
SUPABASE_URL=https://ccpyhexgpiqdmtwvzjdd.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key
MATTIS_ALLOWED_EMAILS=allowed-test-user@example.com

# Server-only model configuration. Vercel AI Gateway can use
# AI_GATEWAY_API_KEY or the automatically available VERCEL_OIDC_TOKEN.
MATTIS_TUTOR_MODEL=openai/gpt-5.4-mini
MATTIS_TUTOR_ENDPOINT=https://ai-gateway.vercel.sh/v1/chat/completions
AI_GATEWAY_API_KEY=
MATTIS_HOMEWORK_MODEL=openai/gpt-5.4-nano
# Hobby/closed PoC only: keep false and use synthetic data. Set true after
# upgrading to a Vercel plan that supports request-level Zero Data Retention.
MATTIS_AI_ZDR=false
