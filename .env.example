# Server-only Supabase configuration. Never commit a secret/service-role key.
SUPABASE_URL=https://ccpyhexgpiqdmtwvzjdd.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key
# Server-only secret key used only by the Vercel cron worker. Never expose this to the browser.
SUPABASE_SECRET_KEY=
MATTIS_ALLOWED_EMAILS=allowed-test-user@example.com

# Web Push / Vercel Cron. Keep the private key and cron secret server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:replace-with-maintainer@example.com
CRON_SECRET=

# Server-only model configuration. Vercel AI Gateway can use
# AI_GATEWAY_API_KEY or the automatically available VERCEL_OIDC_TOKEN.
MATTIS_TUTOR_MODEL=openai/gpt-4o-mini
MATTIS_TUTOR_ENDPOINT=https://ai-gateway.vercel.sh/v1/chat/completions
AI_GATEWAY_API_KEY=
MATTIS_HOMEWORK_MODEL=openai/gpt-5.4-nano
# Hobby/closed PoC only: keep false and use synthetic data. Set true after
# upgrading to a Vercel plan that supports request-level Zero Data Retention.
MATTIS_AI_ZDR=false

# Stripe Billing (sandbox/test mode). Keep all STRIPE_* values server-side.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASE_PRICE_ID=price_1U8OK4PaIouTyNSDp2tixPd5
STRIPE_EXTRA_LEARNER_PRICE_ID=price_1U8OKYPaIouTyNSD3Zw2yt6R
NEXT_PUBLIC_APP_URL=https://mattis-five.vercel.app
